# Release signing settings. Copy to .env (git-ignored) and fill in:
#
#   cp .env.example .env
#
# Only release builds (SIGN_MODE=release scripts/build_app.sh) read this file; local builds
# ignore it. It is parsed, never executed: one KEY=value per line, no inline comments, values
# optionally in matching quotes. A variable already set in the environment wins over this file.
# The values are in the maintainers' private signing note; never commit them.

# Apple Developer Team ID of the Developer ID Application certificate (10 characters, A-Z 0-9).
APPLE_TEAM_ID=

# Optional: pick the identity when the keychain holds several Developer ID Application
# identities for APPLE_TEAM_ID. Its full SHA-1 hash, or its exact name. Empty: the only one.
SIGN_IDENTITY=

# notarytool keychain profile used by the DMG packager (default: pipecat-notary).
NOTARY_PROFILE=pipecat-notary

# App Store Connect API key, only for the one-time `xcrun notarytool store-credentials` setup
# (docs/development.md, "Notarized DMG"). The .p8 file itself stays out of the repository.
NOTARY_KEY_ID=
NOTARY_ISSUER_ID=
